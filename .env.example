# Base URL of dentalpulse-backend's API (must include /api/v1). Used by
# CheckoutModal to call POST /billing/checkout-session. Required at BUILD
# time (NEXT_PUBLIC_*) — if this isn't set wherever this site actually
# deploys (Vercel env vars, not this file), checkout silently breaks for
# every visitor by falling back to localhost.
#
# Local dev: http://localhost:7000/api/v1 (backend's docker-compose.yml port)
#
# Deployed (this "stripe" branch, until a production backend + live Stripe
# keys exist — see planning/STRIPE_BILLING_INTEGRATION_PLAN.md): point at
# the dev backend, still on Stripe TEST/sandbox keys —
# https://dev-api.dentalpulseai.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:7000/api/v1
